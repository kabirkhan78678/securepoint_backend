# Server Configuration
PORT=4000
NODE_ENV=development
BASE_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
DASHBOARD_URL="http://localhost:3000"

# Stripe Redirect URLs (Can point to backend /user/payment/success or frontend routes)
STRIPE_SUCCESS_URL="http://localhost:4000/user/payment/success"
STRIPE_CANCEL_URL="http://localhost:4000/user/payment/failed"

# Database Configuration (MySQL / Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:@localhost:3306/securepoint"

# JWT Authentication
SECRET_KEY="your_jwt_secret_key_here"

# Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Secure Point" <your-email@gmail.com>'
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
LOGO_URL="http://localhost:4000/mainLogo.png"

# Stripe Configuration
STRIPE_SECRETS="sk_test_..."
STRIPE_SECRET_USER_CONTROLLER="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_WEBHOOK_SIGNING_SECRET="whsec_..."

# Sinch SMS / Verification (Optional)
SINCH_APPLICATION_KEY=""
SINCH_APPLICATION_SECRET=""
SINCH_BASE_URL=""

# RevenueCat (Optional)
REVENUECAT_WEBHOOK_SECRET=""
REVENUECAT_PRODUCT_PLAN_MAP=""
