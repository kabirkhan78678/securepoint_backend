<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css">
  <link rel="icon" href="https://securpoint.app:4000/mainLogo.png" type="image/x-icon">
  <title>Payment Failed</title>

  <style>
    .mainDiv {
      display: flex;
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      background-color: #f9f9f9;
      font-family: 'Open Sans', sans-serif;
    }
    .cardStyle {
      width: 500px;
      background: #fff;
      padding: 40px 30px;
      border-radius: 6px;
      box-shadow: 0 0 6px rgba(0,0,0,0.15);
      text-align: center;
    }
    .ct_trade_logo {
      max-width: 120px;
      display: block;
      margin: 0 auto 20px;
    }
    .failed-icon {
      font-size: 60px;
      color: #e53935;
      margin-bottom: 15px;
    }
    .title {
      font-size: 24px;
      font-weight: 700;
      color: #2F2D3B;
      margin-bottom: 10px;
    }
    .message {
      font-size: 16px;
      color: #555;
      margin-bottom: 25px;
    }
    .ct_custom_btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 600;
      background-color: #048eff;
      color: #fff;
      text-decoration: none;
      margin: 5px;
    }
    footer.ct_footer_bg {
      background-color: #3c434e;
      padding: 15px;
      color: #fff;
      text-align: center;
      margin-top: 40px;
      width: 100%;
    }
  </style>
</head>

<body>

<div class="mainDiv">
  <div class="cardStyle">

    <img src="<%= typeof logoUrl !== 'undefined' ? logoUrl : 'https://securpoint.app:4000/mainLogo.png' %>" class="ct_trade_logo">

    <i class="fa fa-times-circle failed-icon"></i>

    <h2 class="title">Payment Failed</h2>

    <p class="message">
      Unfortunately, your payment could not be processed or was cancelled. Please try again.
    </p>

    <% if (typeof plan !== 'undefined' && plan) { %>
    <p class="message">
      <strong>Plan:</strong> <%= plan.plan_name %> <br>
      <% if (plan.plan_days) { %>
        <strong>Duration:</strong> <%= plan.plan_days %> Month(s) <br>
      <% } %>
      <% if (typeof price !== 'undefined' && price) { %>
        <strong>Amount:</strong> <%= (typeof currencySymbol !== 'undefined' ? currencySymbol : '$') %> <%= price %>
      <% } %>
    </p>
    <% } %>

    <a href="<%= typeof dashboardUrl !== 'undefined' ? dashboardUrl : 'https://securpoint.app:4000' %>" class="ct_custom_btn">Back to Dashboard</a>

  </div>
</div>

<footer class="ct_footer_bg">
  <div>© Copyright <strong>SecurPoint</strong>. All Rights Reserved</div>
</footer>

</body>
</html>
