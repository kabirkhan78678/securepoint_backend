<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Reset Password | SecurPoint</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="/mainLogo.png" type="image/x-icon">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Montserrat', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: #ffffff;
      padding: 24px 16px;
      color: #1f2937;
    }
    .reset-card {
      width: 100%;
      max-width: 480px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 40px 32px;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.06);
      position: relative;
      overflow: hidden;
    }
    .reset-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: linear-gradient(90deg, #048eff, #065492);
    }
    .brand-logo {
      display: block;
      max-height: 52px;
      margin: 0 auto 24px;
      object-fit: contain;
    }
    .form-title {
      font-size: 22px;
      font-weight: 700;
      color: #0f172a;
      text-align: center;
      margin-bottom: 8px;
    }
    .form-subtitle {
      font-size: 13px;
      color: #64748b;
      text-align: center;
      margin-bottom: 28px;
      line-height: 1.5;
    }
    .input-group-custom {
      margin-bottom: 20px;
      position: relative;
    }
    .input-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 8px;
    }
    .input-wrapper {
      position: relative;
    }
    .input-field {
      width: 100%;
      height: 48px;
      padding: 0 44px 0 16px;
      font-size: 15px;
      font-family: inherit;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      background-color: #f8fafc;
      color: #0f172a;
      transition: all 0.2s ease;
      outline: none;
    }
    .input-field:focus {
      border-color: #048eff;
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(4, 142, 255, 0.15);
    }
    .toggle-pass {
      position: absolute;
      top: 50%;
      right: 14px;
      transform: translateY(-50%);
      color: #94a3b8;
      cursor: pointer;
      font-size: 16px;
      padding: 4px;
      transition: color 0.2s;
    }
    .toggle-pass:hover {
      color: #048eff;
    }
    .field-error {
      color: #ef4444;
      font-size: 12px;
      font-weight: 500;
      margin-top: 6px;
      display: none;
    }
    .btn-submit {
      width: 100%;
      height: 48px;
      margin-top: 10px;
      background: linear-gradient(135deg, #048eff 0%, #065492 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(4, 142, 255, 0.35);
      transition: all 0.2s ease;
    }
    .btn-submit:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(4, 142, 255, 0.45);
    }
    .btn-submit:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .alert-box {
      display: none;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 20px;
    }
    .alert-danger {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }
    .pass-rules {
      font-size: 11px;
      color: #64748b;
      margin-top: 6px;
      line-height: 1.5;
    }
    .footer-note {
      text-align: center;
      margin-top: 24px;
      font-size: 12px;
      color: #64748b;
    }
    .footer-note a {
      color: #048eff;
      text-decoration: none;
    }
    .footer-note a:hover {
      text-decoration: underline;
    }
    /* Inline success screen */
    .success-view {
      display: none;
      text-align: center;
      animation: fadeIn 0.4s ease-out;
    }
    .icon-wrapper-success {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e0f2fe;
    }
    .icon-wrapper-success svg {
      width: 44px;
      height: 44px;
      fill: none;
      stroke: #048eff;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .btn-login-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 48px;
      background: linear-gradient(135deg, #048eff 0%, #065492 100%);
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(4, 142, 255, 0.35);
      margin-top: 20px;
      transition: all 0.2s ease;
    }
    .btn-login-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(4, 142, 255, 0.45);
      color: #ffffff;
    }
    .countdown-msg {
      margin-top: 16px;
      font-size: 12px;
      color: #64748b;
    }
    .countdown-val {
      font-weight: 700;
      color: #048eff;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <div class="reset-card">
    <img src="/mainLogo.png" alt="SecurPoint Logo" class="brand-logo" onerror="this.src='/fav_icon.svg'">

    <!-- Form Container -->
    <div id="formContainer">
      <h1 class="form-title">Reset Your Password</h1>
      <p class="form-subtitle">Please enter and confirm your new password below to secure your account.</p>

      <div id="alertBox" class="alert-box alert-danger"></div>

      <form name="signupForm" id="signupForm" method="post" action="/admin/resetPassword">
        <input type="hidden" name="token" id="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

        <div class="input-group-custom">
          <label class="input-label" for="password">New Password</label>
          <div class="input-wrapper">
            <input type="password" id="password" name="password" class="input-field" placeholder="Enter new password" required autocomplete="new-password">
            <span class="toggle-pass" onclick="togglePass('password', this)" title="Show/Hide Password">
              <i class="fa-solid fa-eye-slash"></i>
            </span>
          </div>
          <div class="pass-rules">At least 8 characters, one uppercase letter, and one special character.</div>
          <div class="field-error" id="passwordError"></div>
        </div>

        <div class="input-group-custom">
          <label class="input-label" for="confirmPassword">Confirm Password</label>
          <div class="input-wrapper">
            <input type="password" id="confirmPassword" name="confirm_password" class="input-field" placeholder="Re-enter new password" required autocomplete="new-password">
            <span class="toggle-pass" onclick="togglePass('confirmPassword', this)" title="Show/Hide Password">
              <i class="fa-solid fa-eye-slash"></i>
            </span>
          </div>
          <div class="field-error" id="confirmPasswordError"></div>
        </div>

        <button type="submit" id="submitButton" class="btn-submit">
          <span id="btnText">Save New Password</span>
        </button>
      </form>
    </div>

    <!-- Success View -->
    <div id="successView" class="success-view">
      <div class="icon-wrapper-success">
        <svg viewBox="0 0 24 24">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>
      <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Congratulations!</h2>
      <p style="font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 12px;">
        Your Account Password has been set successfully.<br>You can now sign in with your new credentials.
      </p>

      <a id="successLoginLink" href="https://securpoint.app/admin/login" class="btn-login-cta">
        Proceed to Login &rarr;
      </a>

      <div class="countdown-msg">
        Redirecting you to the login screen in <span class="countdown-val" id="countdownVal">5</span> seconds...
      </div>
    </div>
  </div>

  <div class="footer-note">
    &copy; <%= new Date().getFullYear() %> SecurPoint. All rights reserved. &bull; <a href="https://securpoint.app">SecurPoint Home</a>
  </div>

  <script>
    function togglePass(fieldId, el) {
      const field = document.getElementById(fieldId);
      const icon = el.querySelector('i');
      if (field.type === 'password') {
        field.type = 'text';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      } else {
        field.type = 'password';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      }
    }

    const form = document.getElementById('signupForm');
    const formContainer = document.getElementById('formContainer');
    const successView = document.getElementById('successView');
    const alertBox = document.getElementById('alertBox');
    const submitBtn = document.getElementById('submitButton');
    const btnText = document.getElementById('btnText');
    const passError = document.getElementById('passwordError');
    const confirmError = document.getElementById('confirmPasswordError');

    const defaultLoginUrl = "<%= (typeof loginUrl !== 'undefined' && loginUrl ? loginUrl : 'https://securpoint.app/admin/login').replace(/\/home(?=\/admin\/login)/i, '') %>";

    function showError(el, msg) {
      el.textContent = msg;
      el.style.display = 'block';
    }

    function clearErrors() {
      passError.style.display = 'none';
      confirmError.style.display = 'none';
      alertBox.style.display = 'none';
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      clearErrors();

      const token = document.getElementById('token').value;
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      let valid = true;

      if (!password || password.length < 8) {
        showError(passError, 'Password must be at least 8 characters long.');
        valid = false;
      } else if (!/[A-Z]/.test(password)) {
        showError(passError, 'Password must contain at least one uppercase letter (A-Z).');
        valid = false;
      } else if (!/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~`]/.test(password)) {
        showError(passError, 'Password must contain at least one special character (!, @, #, $, etc.).');
        valid = false;
      }

      if (password !== confirmPassword) {
        showError(confirmError, 'Passwords do not match.');
        valid = false;
      }

      if (!valid) return;

      submitBtn.disabled = true;
      btnText.textContent = 'Updating Password...';

      try {
        const response = await fetch('/admin/resetPassword', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ token, password, confirm_password: confirmPassword })
        });

        const data = await response.json();

        if (response.ok && (data.success || data.status === 200)) {
          // Transition to success view smoothly
          formContainer.style.display = 'none';
          successView.style.display = 'block';

          let rawLogin = data.loginUrl || defaultLoginUrl || 'https://securpoint.app/admin/login';
          const loginUrl = rawLogin.replace(/\/home(?=\/admin\/login)/i, '');
          document.getElementById('successLoginLink').href = loginUrl;

          let seconds = 5;
          const countEl = document.getElementById('countdownVal');
          const timer = setInterval(() => {
            seconds--;
            if (countEl) countEl.textContent = seconds;
            if (seconds <= 0) {
              clearInterval(timer);
              window.location.href = loginUrl;
            }
          }, 1000);
        } else {
          alertBox.textContent = data.message || 'Unable to reset password. Please request a new reset link.';
          alertBox.style.display = 'block';
          submitBtn.disabled = false;
          btnText.textContent = 'Save New Password';
        }
      } catch (err) {
        // Fallback: standard form submit if fetch fails
        form.submit();
      }
    });
  </script>
</body>
</html>
