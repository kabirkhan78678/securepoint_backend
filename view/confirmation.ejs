<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css">
  <link rel="icon" href="https://securpoint.app:4000/mainLogo.png" type="image/x-icon">
  <title>Payment Confirmation</title>

  <style>
    .mainDiv {
      display: flex;
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      background-color: #f9f9f9;
      font-family: 'Open Sans', sans-serif;
    }
    .cardStyle {
      width: 500px;
      background: #fff;
      padding: 40px 30px;
      border-radius: 6px;
      box-shadow: 0 0 6px rgba(0,0,0,0.15);
      text-align: center;
    }
    .ct_trade_logo {
      max-width: 120px;
      display: block;
      margin: 0 auto 20px;
    }
    .success-icon {
      font-size: 60px;
      color: #4CAF50;
      margin-bottom: 15px;
    }
    .title {
      font-size: 24px;
      font-weight: 700;
      color: #2F2D3B;
      margin-bottom: 10px;
    }
    .message {
      font-size: 16px;
      color: #555;
      margin-bottom: 25px;
    }
    .ct_custom_btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 600;
      background-color: #048eff;
      color: #fff;
      text-decoration: none;
    }
    footer.ct_footer_bg {
      background-color: #3c434e;
      padding: 15px;
      color: #fff;
      text-align: center;
      margin-top: 40px;
      width: 100%;
    }
  </style>
</head>

<body>

<div class="mainDiv">
  <div class="cardStyle">

    <img src="https://securpoint.app:4000/mainLogo.png" class="ct_trade_logo">

    <i class="fa fa-check-circle success-icon"></i>

    <h2 class="title">Payment Successful</h2>

    <p class="message">
      Thank you! Your subscription purchase has been successfully completed.
    </p>

    <p class="message">
      <strong>Plan:</strong>  Dummy <br>
      <strong>Amount Paid:</strong> ₹ 1708
    </p>

    <a href="https://securpoint.app:4000" class="ct_custom_btn">Go to Dashboard</a>

  </div>
</div>

<footer class="ct_footer_bg">
  <div>© Copyright <strong>SecurPoint</strong>. All Rights Reserved</div>
</footer>

</body>
</html>
