generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUBADMIN
}

model User {
  id                 Int                @id @default(autoincrement())
  email              String?            @unique
  password           String?
  full_name          String?
  phone_no           String?            @unique
  otp                String?
  fcm_token          String?
  avatar_url         String?
  notes              String?            @db.LongText
  token              String?
  isVerified         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  nameStatus         Int                @default(0)
  lastSeen           DateTime?
  otpExpiration      DateTime?
  country            String?
  promotedAssetCount Int                @default(0)
  isOnline           Int                @default(0)
  status             Int                @default(1)
  ActiveChat         ActiveChat[]
  Asset              Asset[]
  ChatMessage        ChatMessage[]
  Notification       Notification[]
  ReportAsset        ReportAsset[]
  ReportUser         ReportUser[]
  SaveAsset          SaveAsset[]
  UnreadCount        UnreadCount[]
  UserSetting        UserSetting[]
  UserSubscription   UserSubscription[]
  chats              Chat[]             @relation("participants")

  UserUpdateRequests UserUpdateRequests[]

  AdminChat AdminChat[]

  AdminChatMessage AdminChatMessage[]

  AdminNotification AdminNotification[]
}

model Feature {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]
}

model Permission {
  id        Int     @id @default(autoincrement())
  adminId   Int
  featureId Int
  admin     Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
}

model Asset {
  id              Int           @id @default(autoincrement())
  userId          Int
  AssetName       String?       @db.LongText
  AssetDetails    String?       @db.LongText
  AssetIdentifier String        @db.VarChar(255)
  categoryId      Int
  subCategoryId   Int
  lock            Int           @default(1)
  promote         Int           @default(0)
  reviewStatus    Int? // NULL = No report, 0 = Pending, 1 = Awaiting user fix, 2 = Resolved
  adminFeedback   String?
  reportedCount   Int?
  status          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expireAt        String?
  longitude       String?       @db.VarChar(200)
  latitude        String?       @db.VarChar(200)
  UIC             String        @unique
  blockStatus     Int           @default(1)
  isVisible       Boolean       @default(true)
  category        Category      @relation(fields: [categoryId], references: [id])
  subCategory     SubCategory   @relation(fields: [subCategoryId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  AssetImages     AssetImages[]
  ReportAsset     ReportAsset[]
  SaveAsset       SaveAsset[]

  @@index([categoryId], map: "Asset_categoryId_fkey")
  @@index([subCategoryId], map: "Asset_subCategoryId_fkey")
  @@index([userId], map: "Asset_userId_fkey")
}

model Category {
  id            Int           @id @default(autoincrement())
  categoryName  String
  categoryImage String?
  display_order Int           @default(1)
  Asset         Asset[]
  SubCategory   SubCategory[]
}

model SubCategory {
  id          Int      @id @default(autoincrement())
  subCategory String?
  categoryId  Int
  Asset       Asset[]
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "SubCategory_categoryId_fkey")
}

model AssetImages {
  id        Int     @id @default(autoincrement())
  assetId   Int
  image_url String?
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "AssetImages_assetId_fkey")
}

model AssetStatus {
  id   Int    @id @default(autoincrement())
  name String
}

model SaveAsset {
  id           Int      @id @default(autoincrement())
  assetId      Int
  saveByUserId Int
  categoryId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [saveByUserId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "SaveAsset_assetId_fkey")
  @@index([saveByUserId], map: "SaveAsset_saveByUserId_fkey")
}

model Plan {
  id               Int                @id @default(autoincrement())
  plan_name        String
  plan_type        String
  plan_days        Int
  amount           String?
  inr              String?
  usd              String?
  ngn              String?
  gbp              String?
  initiate_chat    Int
  createdAt        DateTime           @default(now())
  reportAsset      Int
  reportProfile    Int
  editAssetName    Int
  assetPromote     Int
  UserSubscription UserSubscription[]
}

model UserSubscription {
  id             Int      @id @default(autoincrement())
  planId         Int
  userId         Int
  created_at     DateTime @default(now())
  expired_at     DateTime
  sub_status     Int
  start_date     DateTime
  payment_method String?
  overlap_status Int?     @default(0)
  refund_status  Int?     @default(0)
  overlap_date   DateTime
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId], map: "UserSubscription_planId_fkey")
  @@index([userId], map: "UserSubscription_userId_fkey")
}

model ReportAsset {
  id         Int      @id @default(autoincrement())
  assetId    Int
  reportedBy Int
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  feedback   String?
  status     Int      @default(0)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([assetId], map: "ReportAsset_assetId_fkey")
  @@index([reportedBy], map: "ReportAsset_reportedBy_fkey")
}

model ReportUser {
  id               Int      @id @default(autoincrement())
  reportedByUserId Int
  reportedToUserId Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reason           String?
  reportedTo       User     @relation(fields: [reportedToUserId], references: [id], onDelete: Cascade)

  @@index([reportedToUserId], map: "ReportUser_reportedToUserId_fkey")
}

model UserSetting {
  id                          Int     @id @default(autoincrement())
  lastSeen                    Boolean @default(true)
  userId                      Int
  chatNotification            Boolean @default(true)
  featurePlanNotification     Boolean @default(true)
  securePointPlanNotification Boolean @default(true)
  emailNotification           Boolean @default(true)
  user                        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "UserSetting_userId_fkey")
}

model Notification {
  id        Int      @id @default(autoincrement())
  byUserId  Int?
  byAdmin   Admin?   @relation(fields: [byAdminId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  byAdminId Int?
  toUserId  Int?
  isRead    Boolean  @default(false)
  content   String?  @db.LongText
  title     String?
  type      String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  byUser    User?    @relation(fields: [byUserId], references: [id], onDelete: Cascade)

  @@index([byUserId], map: "Notification_byUserId_fkey")
}

model Chat {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(255)
  lastMessageId Int?          @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())
  ActiveChat    ActiveChat[]
  lastMessage   ChatMessage?  @relation("LastMessage", fields: [lastMessageId], references: [id])
  ChatMessage   ChatMessage[] @relation("ChatMessages")
  UnreadCount   UnreadCount[]
  participants  User[]        @relation("participants")
}

model ActiveChat {
  id        Int      @id @default(autoincrement())
  userId    Int
  chatId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "ActiveChat_chatId_fkey")
  @@index([userId], map: "ActiveChat_userId_fkey")
}

model UnreadCount {
  id          Int  @id @default(autoincrement())
  userId      Int
  chatId      Int
  unreadCount Int  @default(0)
  chat        Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "UnreadCount_chatId_fkey")
  @@index([userId], map: "UnreadCount_userId_fkey")
}

model ChatMessage {
  id              Int      @id @default(autoincrement())
  content         String?  @db.LongText
  senderId        Int
  chatId          Int
  isLink          Int      @default(0)
  isLinkId        String?
  isUrl           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  lastMessageChat Chat?    @relation("LastMessage")
  chat            Chat     @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "ChatMessage_chatId_fkey")
  @@index([senderId], map: "ChatMessage_senderId_fkey")
}

model Admin {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  plainPassword String?
  otp           String?
  fcm_token     String?
  full_name     String?
  token         String?
  phone_no      String?        @unique
  role          Role           @default(ADMIN)
  Notification  Notification[]

  AdminChat AdminChat[]

  AdminChatMessage AdminChatMessage[]
  Permission       Permission[]
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String   @db.LongText
  answer    String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model UserUpdateRequests {
  id        Int      @id @default(autoincrement())
  userId    Int
  newEmail  String?  @unique
  newPhone  String?  @unique
  status    String   @default("Pending") // "Pending", "Approved", "Rejected"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminChat {
  id            Int                @id @default(autoincrement())
  userId        Int
  adminId       Int
  lastMessageId Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lastMessage   AdminChatMessage?  @relation("LastMessage", fields: [lastMessageId], references: [id])
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin         Admin              @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages      AdminChatMessage[]

  @@unique([userId, adminId]) // only one chat per user-admin pair
}

model AdminChatMessage {
  id            Int      @id @default(autoincrement())
  chatId        Int
  senderUserId  Int?
  senderAdminId Int?
  content       String   @db.LongText
  createdAt     DateTime @default(now())

  chat        AdminChat @relation(fields: [chatId], references: [id])
  senderUser  User?     @relation(fields: [senderUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  senderAdmin Admin?    @relation(fields: [senderAdminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  AdminChat AdminChat[] @relation("LastMessage")
}

enum AssignTo {
  PRIVACY
  TERMS
}

model TermsAndPrivacy {
  id      Int      @id @default(autoincrement())
  content String?  @db.LongText
  type    AssignTo @unique
}

enum type {
  MONITOR
  LOCK
  PROMOTE
  ASSET
}

model Label {
  id      Int     @id @default(autoincrement())
  content String? @db.LongText
  type    type    @unique
}

model AdminNotification {
  id        Int      @id @default(autoincrement())
  byUserId  Int?
  toAdminId Int?
  isRead    Boolean  @default(false)
  content   String?  @db.LongText
  title     String?
  type      String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  byUser    User?    @relation(fields: [byUserId], references: [id], onDelete: Cascade)

  @@index([byUserId], map: "Notification_byUserId_fkey")
}

model ContactUs {
  id           Int       @id @default(autoincrement())
  full_name    String?   @db.LongText
  email        String?   @db.LongText
  phone_number String?   @db.VarChar(20)
  message      String?   @db.LongText
  created_at   DateTime  @default(now())
}